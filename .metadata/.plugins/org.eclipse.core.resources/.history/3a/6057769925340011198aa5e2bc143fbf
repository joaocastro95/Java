package business;

public class Carro extends Veiculo {

    private int quantidadePortas;

    public Carro(String modelo, String fabricante, int ano, int portas) {
        super(modelo, fabricante, ano);
        this.quantidadePortas = portas;
    }

    @Override
    public void acelerar() {
        if (velocidadeAtual < 180)
            velocidadeAtual += 10;
    }
}